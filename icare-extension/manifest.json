{
  "manifest_version": 3,
  "name": "FutureCare Weekly — iCare Reports & Tasks",
  "version": "1.2.0",
  "description": "التحليل الأسبوعي داخل الإضافة: تقرير الأداء (جدة، مكة، ينبع) من iCare، ملخص وأطباء، وفتح التاسكات والحوالات كـ loop — متزامن مع موقع التحليل.",
  "permissions": [
    "storage",
    "tabs",
    "activeTab",
    "scripting",
    "tabGroups",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://icare.com.sa/*",
    "https://*.icare.com.sa/*",
    "https://api.deepseek.com/*",
    "https://api.fc.med.sa/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://icare.com.sa/*",
        "https://*.icare.com.sa/*"
      ],
      "js": [
        "src/recorder.js"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true
    },
    {
      "matches": [
        "https://icare.com.sa/*"
      ],
      "js": [
        "icare-token.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://weeklyanalysisfuturecare.netlify.app/*",
        "http://localhost:5177/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "FutureCare Weekly — iCare Reports & Tasks",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
